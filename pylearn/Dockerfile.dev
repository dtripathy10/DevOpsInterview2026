FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Only the dependency files are baked in. Your source code is NOT copied:
# it comes from your local folder, mounted at /app when the container runs.
COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt

EXPOSE 5000

# Flask dev server with auto-reload, reachable from the host
CMD ["flask", "--app", "app", "run", "--debug", "--host", "0.0.0.0", "--port", "5000"]
